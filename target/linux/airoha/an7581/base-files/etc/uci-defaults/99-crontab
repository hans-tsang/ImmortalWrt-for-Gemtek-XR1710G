#!/bin/sh
# Ensure default crontab entries exist in overlay
# This runs once on first boot / factory reset, writing to overlay
# which persists across sysupgrade (when /etc/crontabs/ is retained)

mkdir -p /etc/crontabs

# Only write if no existing crontab (preserve user modifications)
if [ ! -s /etc/crontabs/root ]; then
	cat > /etc/crontabs/root << 'EOF'
# LED off schedule is disabled by default; remove the leading # of the
# cron lines below to enable it.
# Every day at 21:30 turn the LED off (front green LED only)
# 30 21 * * * echo none > /sys/class/leds/status:green/trigger && echo 0 > /sys/class/leds/status:green/brightness
# Every day at 07:00 turn the LED on (front green LED only)
# 0 7 * * * echo default-on > /sys/class/leds/status:green/trigger
EOF
	chmod 644 /etc/crontabs/root
fi

exit 0
