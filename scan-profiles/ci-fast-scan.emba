# EMBA scan profile for GitHub-hosted CI runs of this fork.
#
# It mirrors EMBA's default-scan profile but drops the modules that regularly
# push a scan past the GitHub Actions runtime limit (Ghidra/radare decompilation,
# CWE checker, John the Ripper, user-mode emulation and the binary map builder).
# Use EMBA's own ./scan-profiles/default-scan.emba for the full, slow analysis.

export FORMAT_LOG=1
export THREADED=1
export SHORT_PATH=1
export HTML=1

# no user-mode emulation in CI - it is one of the slowest parts of a scan
export QEMULATION=0

# disable yara tests (s110)
export YARA=0

# extended binary tests stay enabled, but keep the binary budget small
export BINARY_EXTENDED=1
export S16_MIN_RUNTIME=0
export S17_MIN_RUNTIME=0
export MAX_EXT_CHECK_BINS=15

# VEX metrics (check for KEV, Exploits, EPSS)
export VEX_METRICS=1

# long running modules disabled by EMBA's default profile
export MODULE_BLACKLIST+=( "S10_binaries_basic_check" "S99_grepit" "S110_yara_check" "F20_vul_aggregator" )
export MODULE_BLACKLIST+=( "F10_license_summary" )

# additional long running modules disabled for CI runs
export MODULE_BLACKLIST+=( "S15_radare_decompile_checks" "S16_ghidra_decompile_checks" "S17_cwe_checker" )
export MODULE_BLACKLIST+=( "S109_jtr_local_pw_cracking" "S115_usermode_emulator" "S130_binary_map_builder" )

# enable silent mode and status bar
export DISABLE_STATUS_BAR=0
export SILENT=1

# no AI connection
export AI_OPTION=0

# the binary map generator is disabled together with S130
export EMBA_MAP_GENERATOR=0

# we output the profile only at the beginning - outside the docker environment
if [[ $IN_DOCKER -ne 1 ]] ; then
  print_output "$(indent "$(orange "Adds ANSI color codes to log")")" "no_log"
  print_output "$(indent "$(orange "Activate multi threading")")" "no_log"
  print_output "$(indent "$(orange "Prints only relative paths")")" "no_log"
  print_output "$(indent "$(orange "Activates web report creation in log path")")" "no_log"
  print_output "$(indent "$(orange "Runs EMBA in docker container")")" "no_log"
  print_output "$(indent "$(orange "Disable EMBA module via profile")")" "no_log"
  for MODULE_ in "${MODULE_BLACKLIST[@]}"; do
    print_output "$(indent "$(orange "Blacklisted module: $MODULE_")")" "no_log"
  done
  export USE_DOCKER=1
fi
